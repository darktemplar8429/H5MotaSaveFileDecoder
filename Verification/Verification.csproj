<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../H5MotaSaveDecoder/H5MotaSaveDecoder.csproj" />
    <!-- Raw assembly references need an entry in this executable's dependency manifest too. -->
    <Reference Include="Jint">
      <HintPath>../H5MotaSaveDecoder/Libraries/Jint.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="over-limit.lz.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
